{
  "name": "restored-healthy-homes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "preview": "cross-env RHH_APP_MODE=demo next start --hostname 127.0.0.1",
    "build:demo": "cross-env RHH_APP_MODE=demo next build",
    "typecheck": "cross-env RHH_APP_MODE=demo next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --conditions=react-server --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:compat": "playwright test --config=playwright.compat.config.ts",
    "audit:performance": "node scripts/measure-performance.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:demo",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{ts,mjs,json}\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
