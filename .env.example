# Explicitly select demo for local development without external credentials.
# A production-mode preview requires this explicit opt-in; never use it for launch.
RHH_APP_MODE=demo
# Optional error-state verification: RHH_DEMO_SCENARIO=error

# Stage 1 connected staging only (set RHH_APP_MODE=staging locally).
# Replace placeholders in ignored .env.local; never commit environment values.
NEXT_PUBLIC_SUPABASE_URL=https://<approved-staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<staging-publishable-key>
# No Supabase secret/service-role key or database password is needed by the app.
# Privileged migration credentials belong only in a secure local CLI environment.
# VERCEL_ENV=production remains blocked in either mode.

# Stage 2: exact application origin (also allowlist both callback URLs in Supabase).
RHH_AUTH_ORIGIN=http://127.0.0.1:3230
# Generate a random secret locally; keep it server-only and out of source control.
RHH_AUTH_COOKIE_SECRET=<random-server-only-secret-at-least-32-characters>

# Optional live Stage 3 test runner only: two distinct, confirmed test accounts.
# Keep these server/local-only. Never use client credentials or commit values.
# RHH_TEST_MEMBER_A_EMAIL=<designated-test-email-a>
# RHH_TEST_MEMBER_A_PASSWORD=<local-test-password-a>
# RHH_TEST_MEMBER_B_EMAIL=<designated-test-email-b>
# RHH_TEST_MEMBER_B_PASSWORD=<local-test-password-b>

# Inquiry notification queue: real delivery stays disabled until provider approval.
RHH_INQUIRY_EMAIL_PROVIDER=disabled
# RHH_INQUIRY_EMAIL_FROM=<provider-approved-verified-sender-address>
# RHH_INQUIRY_WORKER_SECRET=<random-base64url-server-secret-32-to-128-characters>
# Inbox links reuse the trusted RHH_AUTH_ORIGIN above.
# No scheduler or worker key is activated by these placeholders.
